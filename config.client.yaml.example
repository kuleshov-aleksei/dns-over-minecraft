# Local DNS client service config.
# Run with:  dnsmc -C -config config.client.yaml
# (or:        make client-service)
suffix: ".mc"
client:
  listen: "127.0.0.1:53" # local DNS listener (UDP+TCP); :53 needs root or CAP_NET_BIND_SERVICE
  servers:
    # queries rotate round-robin across servers; unreachable servers are
    # skipped (and logged) until a healthy one answers
    - "127.0.0.1:25565"
  cache:
    disabled: false # set true to disable client-side caching (forward every query to a server)
    size: 2048
    ttl: 5m
    negativeTtl: 30s
  passphrase: "duck" # must match the server's `security.passphrase` ("" = no auth). Sent as
                     # "p.<passphrase>." prefix in the server address; keep it 6+ lowercase alnum.
  vpnDNS:
    # DNS servers from active WireGuard VPN connections are discovered
    # automatically via NetworkManager (D-Bus) and queried before the dnsmc
    # servers
    allowFallbackToTunnel: true # when every VPN DNS server is unreachable: true =
                                # fall back to dnsmc servers (availability first);
                                # false = return SERVFAIL so internal names never
                                # leak to remote dnsmc servers during a VPN outage.
    refreshInterval: 5          # seconds between NetworkManager DNS re-reads