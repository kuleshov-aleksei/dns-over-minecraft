[Unit]
Description=DNS over Minecraft client (local DNS resolver)
After=network.target

[Service]
Type=simple
User=dnsmc
ExecStart=/usr/local/bin/dnsmc -C -config /etc/dnsmc/config.client.yaml
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
# Listening on 127.0.0.1:53 needs CAP_NET_BIND_SERVICE unless a high port is used:
# AmbientCapabilities=CAP_NET_BIND_SERVICE
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target